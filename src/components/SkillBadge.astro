---
import { skillCategoryColors, defaultSkillHover } from '@data/colorTokens';

interface Props {
  skills: string[];
  category: string;
}

const { skills, category } = Astro.props;

const hoverClasses = skillCategoryColors[category] ?? defaultSkillHover;
---

<div class="space-y-4">
  <h3 class="text-sm font-bold uppercase tracking-widest text-muted-foreground">
    {category}
  </h3>
  <ul class="flex flex-wrap gap-2" role="list">
    {
      skills.map((skill) => (
        <li>
          <button
            type="button"
            class={`gsap-skill-badge px-3 py-1.5 rounded-lg border border-border bg-muted/50 text-foreground text-sm font-medium transition-colors duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mauve ${hoverClasses}`}
          >
            {skill}
          </button>
        </li>
      ))
    }
  </ul>
</div>
