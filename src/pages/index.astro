---
import ExperienceItem from '@components/ExperienceItem.astro';
import Footer from '@components/Footer.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import SkillBadge from '@components/SkillBadge.astro';
import Layout from '@layouts/Layout.astro';
import { cv } from '@data/cv';
---

<Layout title={`${cv.name} | ${cv.title}`} description={cv.seoDescription}>
  <main class="animate-in fade-in duration-700">
    <Hero
      name={cv.name}
      title={cv.title}
      location={cv.location}
      email={cv.email}
      phone={cv.phone}
      github={cv.github}
      summary={cv.summary}
    />

    <Section title="Professional Experience">
      <div class="relative border-l border-gray-500/40 ml-3 md:ml-4">
        {cv.experience.map((exp) => <ExperienceItem {...exp} />)}
      </div>
    </Section>

    <Section title="Core Skills">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          cv.skills.map((skill) => (
            <SkillBadge category={skill.category} skills={skill.items} />
          ))
        }
      </div>
    </Section>

    <div
      class="grid grid-cols-1 md:grid-cols-2 container mx-auto max-w-4xl last:border-0 h-full"
    >
      <Section
        title="Education"
        className="border-r border-gray-500/40 border-b-0"
      >
        <div>
          <h3 class="text-xl font-bold text-foreground">
            {cv.education.degree}
          </h3>
          <p class="text-mauve font-medium">
            {cv.education.institution}
          </p>
        </div>
      </Section>

      <Section title="Languages" className="border-b-0">
        <ul class="space-y-2" role="list">
          {
            cv.languages.map((lang) => (
              <li class="flex items-center gap-3 text-muted-foreground">
                <span class="w-2 h-2 rounded-full bg-mauve" aria-hidden="true" />
                {lang}
              </li>
            ))
          }
        </ul>
      </Section>
    </div>

    <Footer />
  </main>
</Layout>
