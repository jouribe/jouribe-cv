---
import { SEO } from 'astro-seo';
import SpeedInsights from '@vercel/speed-insights/astro';
import { cv } from '@data/cv';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = cv.seoDescription,
  image,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || 'https://jouribe.dev',
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="geo.region" content="PE-LIM" />
    <meta name="geo.country" content="PE" />
    <meta name="geo.placename" content="Lima, Peru" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: image || 'https://jouribe.dev/og-image.webp',
        },
        optional: {
          siteName: 'Jorge O. Uribe',
          description: description,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: image || 'https://jouribe.dev/og-image.webp',
      }}
    />
    <!-- Bebas Neue: display font used for headings only -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <!-- Theme initializer: runs before paint to avoid flash -->
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        const f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-5PFK9WH9');
    </script>
    <!-- End Google Tag Manager -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: cv.name,
        alternateName: 'jouribe',
        url: 'https://jouribe.dev',
        image: 'https://jouribe.dev/profile.jpg',
        sameAs: [cv.github, cv.linkedin, cv.twitter],
        jobTitle: cv.title,
        worksFor: {
          '@type': 'Organization',
          name: 'JL Labs',
        },
        alumniOf: {
          '@type': 'EducationalOrganization',
          name: cv.education.institution,
          url: 'https://uni.edu.pe',
        },
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'PE',
          addressRegion: 'Lima',
          addressLocality: 'Lima',
        },
        knowsLanguage: ['es-PE', 'en'],
        description: description,
      })}
    />
  </head>
  <body
    class="min-h-screen antialiased selection:bg-surface2 selection:text-text"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5PFK9WH9"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>
    <SpeedInsights />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<!-- Skill badge interaction tracking via event delegation -->
<script is:inline>
  document.addEventListener('click', (event) => {
    const badge = event.target.closest('.gsap-skill-badge');
    if (badge) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'skill_interaction',
        skill_name: badge.innerText.trim(),
      });
    }
  });
</script>

<!-- GSAP animations -->
<script>
  import { initAllAnimations } from '@scripts/animations';
  initAllAnimations();
</script>
